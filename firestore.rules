rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data partitioning
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /products/{productId} {
        allow read, write: if isOwner(userId) && isValidId(productId);
      }

      match /salesmen/{salesmanId} {
        allow read, write: if isOwner(userId) && isValidId(salesmanId);
      }

      match /dispatches/{dispatchId} {
        allow read, write: if isOwner(userId) && isValidId(dispatchId);
      }

      match /damageLogs/{logId} {
        allow read, write: if isOwner(userId) && isValidId(logId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) && isValidId(settingId);
      }
    }
  }
}
